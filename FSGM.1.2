import torch
import torch.nn as nn


torch.manual_seed(13)

N = nn.Sequential(nn.Linear(10, 10, bias=False),
                  nn.ReLU(),
                  nn.Linear(10, 10, bias=False),
                  nn.ReLU(),
                  nn.Linear(10, 3, bias=False))


x = torch.rand((1,10))

t = 1  

epsReal = 0.5
eps = epsReal - 1e-7

original_class = N(x).argmax(dim=1).item()
print("Original Class: ", original_class)
assert(original_class == 2)

L = nn.CrossEntropyLoss()

# ---- Attempt 1: plain single-step FGSM (same method as part 1) ----
x_grad_input = x.clone().detach().requires_grad_()
loss = L(N(x_grad_input), torch.tensor([t], dtype=torch.long))
loss.backward()
adv_x_fgsm = x - eps * torch.sign(x_grad_input.grad)
fgsm_class = N(adv_x_fgsm).argmax(dim=1).item()
print("Single-step FGSM new class:", fgsm_class, "-> success:", fgsm_class == t)
# NOTE: this fails (fgsm_class == 2, not 1), even though the full eps budget is used.

# ---- Attempt 2: PGD with random restarts, still within the same eps ball ----
torch.manual_seed(0)  # separate seed just for restart randomness, kept reproducible
best_norm = None
best_adv = None
num_restarts = 30
num_steps = 500
alpha = 0.05

for restart in range(num_restarts):
    start_noise = (torch.rand((1,10)) * 2 - 1) * eps  
    adv_x = (x + start_noise).clone().detach()
    adv_x = torch.max(torch.min(adv_x, x + eps), x - eps)  

    for step in range(num_steps):
        adv_x.requires_grad_()
        loss = L(N(adv_x), torch.tensor([t], dtype=torch.long))
        grad = torch.autograd.grad(loss, adv_x)[0]
        adv_x = adv_x.detach() - alpha * torch.sign(grad)
        adv_x = torch.max(torch.min(adv_x, x + eps), x - eps)  
        adv_x = adv_x.detach()

    new_class = N(adv_x).argmax(dim=1).item()
    norm = torch.norm((x - adv_x), p=float('inf')).item()
    if new_class == t and (best_norm is None or norm < best_norm):
        best_norm, best_adv = norm, adv_x.clone()

if best_adv is not None:
    print("PGD with random restarts new class:", N(best_adv).argmax(dim=1).item())
    print("Linf norm ||x - x'||:", best_norm)
    assert(N(best_adv).argmax(dim=1).item() == t)
    assert(best_norm <= epsReal)
else:
    print("PGD with random restarts did not find a successful adversarial example.")
